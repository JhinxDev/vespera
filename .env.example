# Network binding (use 127.0.0.1 for local-only, 0.0.0.0 behind a trusted LAN proxy)
VESPERA_HOST=127.0.0.1
VESPERA_PORT=4660

# Optional override for persistent data, SQLite DB, and browser session profiles
# Default: %LOCALAPPDATA%\Vespera (Windows) or ~/.local/share/vespera (Linux/macOS)
VESPERA_DATA_DIR=

# Path to local channel definitions file (copy channels.example.json to channels.local.json)
VESPERA_CHANNELS_FILE=./channels.local.json

# Optional semicolon-separated extra media root directories allowed for preview streaming
VESPERA_ALLOWED_MEDIA_DIRS=

# Optional public URL for OAuth callback redirects (auto-detected from headers when behind TLS proxy)
VESPERA_PUBLIC_BASE_URL=

# Optional official OAuth2 & API credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
X_API_KEY=
X_API_SECRET=
INSTAGRAM_GRAPH_TOKEN=
